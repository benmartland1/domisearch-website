RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_TO_EMAIL=hi@domisearch.com
CONTACT_FROM_EMAIL=website@domisearch.com
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SITE_URL=https://domisearch.com

# £99 AI Visibility Roadmap checkout. Create a £99 GBP one-off Stripe Payment
# Link (collect email ON, success URL = /ai-visibility-roadmap/thanks) and paste
# it here. Until set, the checkout button validates + fires the pixel but does
# not redirect. Domain travels as client_reference_id; email is prefilled.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# ---------------------------------------------------------------------------
# Sanity (headless CMS for the blog) — Studio at /studio
# ---------------------------------------------------------------------------

# From `npx sanity init`, or sanity.io/manage → your project. Not a secret: it
# ships in the browser bundle by design. Required for the site to build.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# The dataset. Optional — defaults to "production" if unset.
NEXT_PUBLIC_SANITY_DATASET=production

# SECRET. sanity.io/manage → API → Tokens → Add token, with Editor permissions.
# Writes posts during migration and reads drafts for preview.
SANITY_API_READ_TOKEN=

# SECRET. Shared with the Sanity webhook so /api/revalidate can verify that a
# request genuinely came from Sanity. Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Client onboarding — onboarding.domisearch.com (app/onboarding, /api/onboarding)
# ---------------------------------------------------------------------------

# SECRET, REQUIRED. Signs resume links so a stranger can't walk into someone
# else's half-finished questionnaire by guessing an id.
# Generate with: openssl rand -hex 32
# Falls back to SANITY_REVALIDATE_SECRET if unset, so links are always signed.
ONBOARDING_SECRET=

# SECRET, REQUIRED. Writes submissions into Sanity.
# sanity.io/manage -> API -> Tokens -> Add token, Editor permission.
# Falls back to SANITY_API_READ_TOKEN, which already has Editor rights — set
# this separately if you ever narrow that one to read-only.
SANITY_API_WRITE_TOKEN=

# Vercel Blob, for logo / brand guidelines / example content uploads (25 MB max).
# Vercel dashboard -> Storage -> Blob -> connect to this project, which sets
# the variable for you. Without it the upload control tells the client to paste
# a link instead; nothing else breaks.
BLOB_READ_WRITE_TOKEN=

# Where the submission notification lands. Defaults to CONTACT_TO_EMAIL, then
# hi@domisearch.com.
ONBOARDING_TO_EMAIL=hi@domisearch.com

# From address for the three client-facing emails (resume link, confirmation,
# copy of answers). Must be a verified Resend sender. Defaults to
# CONTACT_FROM_EMAIL.
ONBOARDING_FROM_EMAIL=onboarding@domisearch.com

# Optional. The origin baked into resume links. Leave unset and the API uses
# the host the request arrived on, which is right in every normal case — set it
# only if the app ever sits behind a proxy that rewrites Host.
NEXT_PUBLIC_ONBOARDING_URL=https://onboarding.domisearch.com

# Optional escape hatch. In production, domisearch.com/onboarding redirects to
# the subdomain. Set to "off" if DNS is mid-flight and that redirect would
# strand people.
ONBOARDING_CANONICAL_REDIRECT=
